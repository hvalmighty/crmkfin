# Copy to .env (never commit it). On Vercel set these under Project > Settings > Environment Variables.

# --- Database -------------------------------------------------------------
# Vercel / any server: PostgreSQL connection string (Neon from the Vercel Marketplace sets this for you).
# Leave empty to use a local SQLite file (instance/crm.db) - fine for running on your own PC.
DATABASE_URL=

# --- Required on Vercel ---------------------------------------------------
# Any long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
CRM_SECRET_KEY=
# Protects the weekly-reminder cron endpoint. Vercel sends it automatically. Use another random string.
CRON_SECRET=

# --- First-run admin (set BEFORE first deploy) -------------------------------
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=

# --- Misc ---------------------------------------------------------------------
CRM_TIMEZONE=Asia/Kolkata
CRM_SESSION_HOURS=8
# Set to 1 when served over HTTPS outside Vercel (Vercel is always secure)
CRM_SECURE_COOKIES=0

# --- Weekly e-mail reminders (any SMTP provider: Gmail app password, Zoho, SES, Office 365...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SSL=1      # use for port 465
# SMTP_STARTTLS=0 # disable STARTTLS if your server doesn't support it
