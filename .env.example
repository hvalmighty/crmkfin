# Copy to .env (never commit it) and export these before starting the app.

# First-run admin (optional - if omitted a random password is printed to the console once)
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=

# Set to 1 when served over HTTPS (recommended in production)
CRM_SECURE_COOKIES=0
CRM_SESSION_HOURS=8
CRM_TIMEZONE=Asia/Kolkata

# Weekly e-mail reminders (any SMTP provider: Gmail app password, Zoho, SES, Office 365...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SSL=1      # use for port 465
# SMTP_STARTTLS=0 # disable STARTTLS if your server doesn't support it
